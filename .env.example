# Shopify App Configuration
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_cart_transforms,read_customers,write_customers

# App URLs
SHOPIFY_APP_URL=https://your-app-url.com
SHOPIFY_REDIRECT_URI=https://your-app-url.com/api/auth/callback
NEXT_PUBLIC_APP_URL=https://your-app-url.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/turbocart

# App Configuration
NODE_ENV=development
HOST=https://your-app-url.com

# Session Secret (generate a random string)
SESSION_SECRET=your_session_secret_here
