{% comment %}
  TurboCart App Embed Block
  This app embed loads globally on the store and enables TurboCart upsells.
  Merchants can activate this from Theme Settings > App embeds in the theme editor.
{% endcomment %}

<script>
  window.TurboCartConfig = {
    shopDomain: '{{ shop.permanent_domain }}',
    enabled: {{ block.settings.enabled }},
    displayPosition: '{{ block.settings.display_position }}',
    maxProducts: {{ block.settings.max_products }},
    appUrl: '{{ shop.metafields.turbocart.app_url | default: "" }}'
  };
</script>

{% if block.settings.enabled %}
  <div id="turbocart-app-embed" data-turbocart-embed></div>
  {{ 'turbocart.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'turbocart.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "TurboCart AI Upsells",
  "target": "body",
  "stylesheet": "turbocart.css",
  "javascript": "turbocart.js",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable TurboCart Upsells",
      "default": true,
      "info": "Toggle to enable or disable upsell recommendations"
    },
    {
      "type": "select",
      "id": "display_position",
      "label": "Display Position",
      "default": "before_checkout",
      "options": [
        {
          "value": "before_checkout",
          "label": "Before checkout button"
        },
        {
          "value": "after_items",
          "label": "After cart items"
        },
        {
          "value": "bottom",
          "label": "Bottom of cart"
        }
      ]
    },
    {
      "type": "range",
      "id": "max_products",
      "min": 1,
      "max": 20,
      "step": 1,
      "label": "Maximum products to show",
      "default": 3,
      "info": "Choose how many upsell products to display (1-20)"
    }
  ]
}
{% endschema %}
