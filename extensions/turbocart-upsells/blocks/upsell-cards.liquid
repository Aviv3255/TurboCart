{% comment %}
  TurboCart - Compact Cards Upsell Display
  Grid layout with image-first cards
{% endcomment %}

<div class="turbocart-cards" data-turbocart-block="cards">
  <div class="turbocart-cards__header">
    <h3 class="turbocart-cards__title">{{ block.settings.heading | default: "Complete your purchase" }}</h3>
  </div>

  <div class="turbocart-cards__grid" data-turbocart-upsells>
    <!-- Upsell product cards will be injected here via JavaScript -->
    <div class="turbocart-cards__loading">
      <div class="turbocart-spinner"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TurboCart Cards",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete your purchase"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Number of columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "max_items",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Maximum items to show",
      "default": 6
    }
  ]
}
{% endschema %}
