{% comment %}
  TurboCart - Product Comparison Table Upsell Display
  Side-by-side comparison of product features and prices
{% endcomment %}

<div class="turbocart-comparison-table" data-turbocart-block="comparison-table">
  <div class="turbocart-comparison-table__header">
    <h3 class="turbocart-comparison-table__title">{{ block.settings.heading | default: "Compare & Choose" }}</h3>
  </div>

  <div class="turbocart-comparison-table__container" data-turbocart-upsells>
    <!-- Comparison table will be injected here via JavaScript -->
    <div class="turbocart-comparison-table__loading">
      <div class="turbocart-spinner"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TurboCart Comparison Table (Cart Only)",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compare & Choose"
    },
    {
      "type": "range",
      "id": "max_products",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Maximum products to compare",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_features",
      "label": "Show feature comparison",
      "default": true
    }
  ]
}
{% endschema %}
