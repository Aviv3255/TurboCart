{% comment %}
  TurboCart - Frequently Bought Together Display
  Bundle-style upsell with contextual pairing
{% endcomment %}

<div class="turbocart-fbt" data-turbocart-block="frequently-bought">
  <div class="turbocart-fbt__header">
    <h3 class="turbocart-fbt__title">{{ block.settings.heading | default: "Customers also bought" }}</h3>
  </div>

  <div class="turbocart-fbt__content" data-turbocart-upsells>
    <!-- Bundle display will be injected here via JavaScript -->
    <div class="turbocart-fbt__loading">
      <div class="turbocart-spinner"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TurboCart Frequently Bought",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customers also bought"
    },
    {
      "type": "checkbox",
      "id": "show_bundle_discount",
      "label": "Show bundle discount",
      "default": true
    },
    {
      "type": "range",
      "id": "discount_percentage",
      "min": 0,
      "max": 25,
      "step": 5,
      "label": "Bundle discount percentage",
      "default": 10
    }
  ]
}
{% endschema %}
