{% comment %}
  TurboCart - Add On Display
  Clean individual add-ons with social proof
{% endcomment %}

<div class="turbocart-addon" data-turbocart-block="frequently-bought">
  <div class="turbocart-addon__content" data-turbocart-upsells>
    <!-- Add-on items will be injected here via JavaScript -->
    <div class="turbocart-addon__loading">
      <div class="turbocart-spinner"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TurboCart Add On",
  "target": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_percentage",
      "label": "Show social proof percentage",
      "default": true
    },
    {
      "type": "range",
      "id": "max_items",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Maximum add-ons to display",
      "default": 2
    }
  ]
}
{% endschema %}
