{% comment %}
  TurboCart - Simple List Upsell Display
  Clean vertical list layout
{% endcomment %}

<div class="turbocart-list" data-turbocart-block="list">
  <div class="turbocart-list__header">
    <h3 class="turbocart-list__title">{{ block.settings.heading | default: "Add to your order" }}</h3>
  </div>

  <div class="turbocart-list__items" data-turbocart-upsells>
    <!-- Upsell products will be injected here via JavaScript -->
    <div class="turbocart-list__loading">
      <div class="turbocart-spinner"></div>
      <p>Loading recommendations...</p>
    </div>
  </div>

  {% if block.settings.show_add_all %}
  <div class="turbocart-list__footer">
    <button class="turbocart-btn turbocart-btn--secondary" data-turbocart-add-all>
      Add All Selected
    </button>
  </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "TurboCart List",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Add to your order"
    },
    {
      "type": "range",
      "id": "max_items",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Maximum items to show",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_add_all",
      "label": "Show 'Add All' button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_checkboxes",
      "label": "Show checkboxes for multi-select",
      "default": true
    }
  ]
}
{% endschema %}
