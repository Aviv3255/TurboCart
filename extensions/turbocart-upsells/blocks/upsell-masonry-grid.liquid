{% comment %}
  TurboCart - Masonry Grid Upsell Display
  Pinterest-style masonry layout with varying card heights
{% endcomment %}

<div class="turbocart-masonry" data-turbocart-block="masonry-grid">
  <div class="turbocart-masonry__header">
    <h3 class="turbocart-masonry__title">{{ block.settings.heading | default: "Complete your purchase" }}</h3>
  </div>

  <div class="turbocart-masonry__grid" data-turbocart-upsells>
    <!-- Upsell products will be injected here via JavaScript -->
    <div class="turbocart-masonry__loading">
      <div class="turbocart-spinner"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TurboCart Masonry Grid (Cart Only)",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete your purchase"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Number of columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "max_items",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Maximum items to show",
      "default": 6
    }
  ]
}
{% endschema %}
