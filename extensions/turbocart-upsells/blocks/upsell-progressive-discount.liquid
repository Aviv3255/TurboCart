{% comment %}
  TurboCart - Progressive Discount Tiers Upsell Display
  Tiered pricing display showing volume discounts
{% endcomment %}

<div class="turbocart-progressive-discount" data-turbocart-block="progressive-discount">
  <div class="turbocart-progressive-discount__header">
    <h3 class="turbocart-progressive-discount__title">{{ block.settings.heading | default: "Buy More, Save More!" }}</h3>
  </div>

  <div class="turbocart-progressive-discount__tiers">
    <!-- Discount tiers will be injected here via JavaScript -->
    <div class="turbocart-progressive-discount__tier">
      <span class="turbocart-progressive-discount__tier-quantity">Buy 2</span>
      <span class="turbocart-progressive-discount__tier-discount">Save 10%</span>
    </div>
    <div class="turbocart-progressive-discount__tier">
      <span class="turbocart-progressive-discount__tier-quantity">Buy 3</span>
      <span class="turbocart-progressive-discount__tier-discount">Save 20%</span>
    </div>
    <div class="turbocart-progressive-discount__tier turbocart-progressive-discount__tier--best">
      <span class="turbocart-progressive-discount__tier-quantity">Buy 4+</span>
      <span class="turbocart-progressive-discount__tier-discount">Save 30%</span>
      <span class="turbocart-progressive-discount__tier-badge">BEST VALUE</span>
    </div>
  </div>

  <div class="turbocart-progressive-discount__products" data-turbocart-upsells>
    <!-- Upsell products will be injected here via JavaScript -->
    <div class="turbocart-progressive-discount__loading">
      <div class="turbocart-spinner"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TC Volume Discount",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Buy More, Save More!"
    },
    {
      "type": "range",
      "id": "tier1_quantity",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Tier 1 quantity",
      "default": 2
    },
    {
      "type": "range",
      "id": "tier1_discount",
      "min": 5,
      "max": 30,
      "step": 5,
      "label": "Tier 1 discount (%)",
      "default": 10
    }
  ]
}
{% endschema %}
