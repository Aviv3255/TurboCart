{% comment %}
  TurboCart - Side Panel Drawer Upsell Display
  Non-intrusive sliding panel from the side
{% endcomment %}

<div class="turbocart-side-drawer" data-turbocart-block="side-drawer">
  <button class="turbocart-side-drawer__toggle" aria-label="View recommendations">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path d="M12 4v16m8-8H4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <span>{{ block.settings.toggle_text | default: "View Add-ons" }}</span>
  </button>

  <div class="turbocart-side-drawer__panel">
    <div class="turbocart-side-drawer__header">
      <h3 class="turbocart-side-drawer__title">{{ block.settings.heading | default: "Suggested Add-ons" }}</h3>
      <button class="turbocart-side-drawer__close" aria-label="Close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="turbocart-side-drawer__content" data-turbocart-upsells>
      <!-- Upsell products will be injected here via JavaScript -->
      <div class="turbocart-side-drawer__loading">
        <div class="turbocart-spinner"></div>
      </div>
    </div>
  </div>

  <div class="turbocart-side-drawer__overlay"></div>
</div>

{% schema %}
{
  "name": "TurboCart Side Drawer (Cart Only)",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Suggested Add-ons"
    },
    {
      "type": "text",
      "id": "toggle_text",
      "label": "Toggle button text",
      "default": "View Add-ons"
    },
    {
      "type": "range",
      "id": "max_items",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Maximum items to show",
      "default": 4
    }
  ]
}
{% endschema %}
