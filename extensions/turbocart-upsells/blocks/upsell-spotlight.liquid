{% comment %}
  TurboCart - Featured Spotlight Upsell Display
  Rotating featured product with auto-transition
{% endcomment %}

<div class="turbocart-spotlight" data-turbocart-block="spotlight">
  <div class="turbocart-spotlight__header">
    <h3 class="turbocart-spotlight__title">{{ block.settings.heading | default: "Featured Recommendation" }}</h3>
  </div>

  <div class="turbocart-spotlight__container" data-turbocart-upsells>
    <!-- Featured product will be injected here via JavaScript -->
    <div class="turbocart-spotlight__loading">
      <div class="turbocart-spinner"></div>
    </div>
  </div>

  <div class="turbocart-spotlight__indicators"></div>
</div>

{% schema %}
{
  "name": "TurboCart Featured Spotlight (Cart Only)",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Recommendation"
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "label": "Auto-rotation speed (seconds)",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Enable auto-rotation",
      "default": true
    }
  ]
}
{% endschema %}
