{% comment %}
  TurboCart - Category Tabs Upsell Display
  Tabbed interface with product categories
{% endcomment %}

<div class="turbocart-sticky-tabs" data-turbocart-block="sticky-tabs">
  <div class="turbocart-sticky-tabs__header">
    <h3 class="turbocart-sticky-tabs__title">{{ block.settings.heading | default: "Shop by Category" }}</h3>
  </div>

  <div class="turbocart-sticky-tabs__nav">
    <!-- Tab navigation will be injected here via JavaScript -->
  </div>

  <div class="turbocart-sticky-tabs__content" data-turbocart-upsells>
    <!-- Tab content will be injected here via JavaScript -->
    <div class="turbocart-sticky-tabs__loading">
      <div class="turbocart-spinner"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TC Category Tabs",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "range",
      "id": "products_per_tab",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Products per tab",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_all_tab",
      "label": "Show 'All' tab",
      "default": true
    }
  ]
}
{% endschema %}
