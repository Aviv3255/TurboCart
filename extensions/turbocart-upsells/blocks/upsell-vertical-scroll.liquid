{% comment %}
  TurboCart - Vertical Scroll Gallery Upsell Display
  Tall vertical gallery with large product images
{% endcomment %}

<div class="turbocart-vertical-scroll" data-turbocart-block="vertical-scroll">
  <div class="turbocart-vertical-scroll__header">
    <h3 class="turbocart-vertical-scroll__title">{{ block.settings.heading | default: "Recommended for you" }}</h3>
  </div>

  <div class="turbocart-vertical-scroll__container">
    <div class="turbocart-vertical-scroll__items" data-turbocart-upsells>
      <!-- Upsell products will be injected here via JavaScript -->
      <div class="turbocart-vertical-scroll__loading">
        <div class="turbocart-spinner"></div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TurboCart Vertical Scroll (Cart Only)",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recommended for you"
    },
    {
      "type": "range",
      "id": "max_items",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Maximum items to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "max_height",
      "min": 400,
      "max": 800,
      "step": 50,
      "label": "Maximum height (px)",
      "default": 600
    }
  ]
}
{% endschema %}
